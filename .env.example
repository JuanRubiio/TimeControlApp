# Identificador UUID inmutable del entorno dedicado de este cliente.
ENVIRONMENT_ID=00000000-0000-4000-8000-000000000001
POSTGRES_SUPERUSER_PASSWORD=replace-local-superuser-secret
POSTGRES_PASSWORD=replace-local-app-secret
# Pepper único por entorno (mín. 32 caracteres), secreto de servidor para índice de PIN de kiosco.
KIOSK_PIN_PEPPER=replace-with-a-unique-local-kiosk-pin-pepper-32-chars
SESSION_COOKIE_NAME=tc_session
SESSION_TTL_HOURS=8
# Sólo Docker local HTTP. En cualquier entorno HTTPS/producción debe ser true.
SESSION_COOKIE_SECURE=false
# Sólo para el conjunto de cuentas @demo.test en HTTP local. Nunca activar en un despliegue.
LOCAL_SYNTHETIC_DEMO_MFA_BYPASS=false
# Sólo para el bootstrap local inicial; no almacenar en el repositorio ni usar en producción.
BOOTSTRAP_ADMIN_EMAIL=admin@example.test
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-unique-password
BOOTSTRAP_ADMIN_NAME=Administrador
# Token opcional para proteger /api/metrics. Déjelo vacío sólo en desarrollo local.
METRICS_BEARER_TOKEN=replace-with-a-unique-metrics-token
