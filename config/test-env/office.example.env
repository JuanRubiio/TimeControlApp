# Perfil local reproducible de pruebas: oficina sintética.
# Copie este archivo a .local/test-office.env y sustituya cada replace-... antes de usar Docker.
# No use estos valores, identificadores ni puertos en un entorno con datos reales.
ENVIRONMENT_ID=30000000-0000-4000-8000-000000000001
POSTGRES_SUPERUSER_PASSWORD=replace-with-local-office-postgres-superuser-password
POSTGRES_PASSWORD=replace-with-local-office-app-password
KIOSK_PIN_PEPPER=replace-with-local-office-kiosk-pepper-at-least-32-chars
SESSION_COOKIE_NAME=tc_office_session
SESSION_TTL_HOURS=8
SESSION_COOKIE_SECURE=false
LOCAL_SYNTHETIC_DEMO_MFA_BYPASS=true
BOOTSTRAP_ADMIN_EMAIL=admin.office@demo.test
BOOTSTRAP_ADMIN_PASSWORD=replace-with-local-office-admin-password
BOOTSTRAP_ADMIN_NAME=Cuenta Demo Administración
METRICS_BEARER_TOKEN=replace-with-local-office-metrics-token
DEMO_PROFILE=office
DEMO_PASSWORD=replace-with-local-office-demo-password-at-least-16-chars
POSTGRES_PORT=5433
APP_PORT=3013
