# Perfil local reproducible de pruebas: empresa multicentro sintética.
# Copie este archivo a .local/test-multisite.env y sustituya cada replace-... antes de usar Docker.
# No use estos valores, identificadores ni puertos en un entorno con datos reales.
ENVIRONMENT_ID=40000000-0000-4000-8000-000000000001
POSTGRES_SUPERUSER_PASSWORD=replace-with-local-multisite-postgres-superuser-password
POSTGRES_PASSWORD=replace-with-local-multisite-app-password
KIOSK_PIN_PEPPER=replace-with-local-multisite-kiosk-pepper-at-least-32-chars
SESSION_COOKIE_NAME=tc_multisite_session
SESSION_TTL_HOURS=8
SESSION_COOKIE_SECURE=false
LOCAL_SYNTHETIC_DEMO_MFA_BYPASS=true
BOOTSTRAP_ADMIN_EMAIL=admin.multisite@demo.test
BOOTSTRAP_ADMIN_PASSWORD=replace-with-local-multisite-admin-password
BOOTSTRAP_ADMIN_NAME=Cuenta Demo Administración
METRICS_BEARER_TOKEN=replace-with-local-multisite-metrics-token
DEMO_PROFILE=multisite
DEMO_PASSWORD=replace-with-local-multisite-demo-password-at-least-16-chars
POSTGRES_PORT=5434
APP_PORT=3014
