FROM postgres:16.6-bookworm
# El cliente debe coincidir con PostgreSQL 16. Node sólo se usa para el cifrado
# local del artefacto; la imagen postgres ya aporta pg_dump/pg_restore 16.
RUN apt-get update && apt-get install -y --no-install-recommends nodejs && rm -rf /var/lib/apt/lists/*
WORKDIR /ops
COPY docker/ops/crypto-backup.mjs ./crypto-backup.mjs
COPY docker/ops/backup.sh ./backup.sh
COPY docker/ops/restore.sh ./restore.sh
RUN chmod 0555 ./backup.sh ./restore.sh
ENTRYPOINT ["/bin/bash"]
