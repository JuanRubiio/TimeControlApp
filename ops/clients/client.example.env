# Copie este archivo fuera del repositorio como ops/clients/<cliente>.env; nunca lo versiona.
CLIENT_SLUG=cliente-piloto
ENVIRONMENT_ID=00000000-0000-4000-8000-000000000001
FUTURE_DOMAIN=piloto-cliente.example.com
APP_IMAGE=time-control:cliente-piloto-v1
APP_PORT=3000
POSTGRES_SUPERUSER_PASSWORD=replace-with-unique-superuser-secret
POSTGRES_PASSWORD=replace-with-unique-app-secret
KIOSK_PIN_PEPPER=replace-with-unique-kiosk-pepper-at-least-32-characters
SESSION_COOKIE_NAME=tc_session
SESSION_TTL_HOURS=8
SESSION_COOKIE_SECURE=true
METRICS_BEARER_TOKEN=replace-with-unique-metrics-token
BACKUP_PASSPHRASE=replace-with-unique-backup-passphrase-at-least-20-chars
# Ruta absoluta en el host, distinta para cada cliente; el proveedor final debe cifrarla en reposo.
BACKUP_DIRECTORY=/secure/isolated-backups/cliente-piloto
